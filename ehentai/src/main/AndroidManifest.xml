<?xml version="1.0" encoding="utf-8"?>
<!--
  Mihon extension manifest.
  The app's ExtensionLoader only treats a package as an extension when it
  declares <uses-feature android:name="tachiyomi.extension" /> and carries
  the source-class / lib-version / nsfw meta-data below.
  Format mirrors the manifest generated by the keiyoushi build-logic.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="tachiyomi.extension" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Tachiyomi: E-Hentai">

        <meta-data
            android:name="tachiyomix.name"
            android:value="E-Hentai" />

        <!-- Relative to the package: eu.kanade.tachiyomi.extension.en.ehentai.Ehentai -->
        <meta-data
            android:name="tachiyomi.extension.class"
            android:value=".Ehentai" />

        <meta-data
            android:name="tachiyomi.extension.nsfw"
            android:value="1" />

        <!-- ContentWarning: SAFE=0, MIXED=1, NSFW=2 -->
        <meta-data
            android:name="tachiyomix.contentWarning"
            android:value="2" />

        <!-- Must be in the app's SUPPORTED_LIB_VERSIONS (1.4 / 1.6). -->
        <meta-data
            android:name="tachiyomix.extensionLib"
            android:value="1.6" />

    </application>

</manifest>
